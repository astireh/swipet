# Скопируйте этот файл в .env и заполните. Файл .env в git НЕ коммитим.

# --- База данных: вариант 1 (быстро, без Postgres) ---
DATABASE_URL=sqlite:///./dev.db
# --- вариант 2: PostgreSQL (тогда строку DATABASE_URL выше удалите) ---
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=petapp

# --- GigaChat (ключ авторизации из личного кабинета developers.sber.ru) ---
GIGACHAT_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=0
GIGACHAT_TIMEOUT=15

# --- ruBERT ---
EMBED_BACKEND=sbert
# 0 - не загружать модель при старте сервера (лента будет считаться по правилам)
RECO_WARMUP=1

# --- Фронтенд ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SQL_ECHO=1
