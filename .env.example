# Скопируйте этот файл в .env и заполните. Файл .env в git НЕ коммитим.

# --- База данных: вариант 1 (быстро, без Postgres) ---
DATABASE_URL=sqlite:///./dev.db
# --- вариант 2: PostgreSQL (тогда строку DATABASE_URL выше удалите) ---
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=petapp

# --- GigaChat (ключ авторизации из личного кабинета developers.sber.ru) ---
GIGACHAT_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=0
GIGACHAT_TIMEOUT=15

# --- ruBERT ---
EMBED_BACKEND=sbert
# 0 - ruBERT не загружается вообще: лента берёт готовые векторы из базы и vectors.json,
#     новые питомцы/опросы ранжируются по правилам, пока кто-то не запустит build_vectors.py
EMBED_ENABLED=1

# --- Вход ---
# 1 - в Swagger и demo.py можно указывать пользователя заголовком X-User-Id (удобно для проверки).
# 0 - только токен из /auth/login (для настоящего запуска)
ALLOW_X_USER_ID=1

# --- Фронтенд ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SQL_ECHO=1
